rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each challenge is one document whose ID is its random 8-character code.
    // Knowing the code is what grants access, so listing (browsing all codes) is blocked.
    match /challenges/{code} {
      allow get, update: if code.matches('^[A-Z0-9]{8}$');
      allow create: if code.matches('^[A-Z0-9]{8}$') && request.resource.data.code == code;
      allow list, delete: if false;
    }
  }
}
